# ==============================================================================
# Default-ignore everything
# ==============================================================================
/*
/.*

# ==============================================================================
# Whitelist Git & Environment Configurations
# ==============================================================================
!.gitignore
!.env.example

# ==============================================================================
# Whitelist CI / Workflows
# ==============================================================================
!/.github/
!/.github/**

# ==============================================================================
# Whitelist Source & Asset Directories
# ==============================================================================
!/app/
!/app/**
!/components/
!/components/**
!/db/
!/db/**
!/evidence/
!/evidence/**
!/fixtures/
!/fixtures/**
!/lib/
!/lib/**
!/public/
!/public/**
!/tests/
!/tests/**
!/tools/
!/tools/**

# ==============================================================================
# Whitelist Project Configurations & Core Submission Docs
# ==============================================================================
!/brief.json
!/drizzle.config.ts
!/eslint.config.mjs
!/LICENSE
!/Makefile
!/next-env.d.ts
!/next.config.ts
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/postcss.config.mjs
!/README.md
!/tailwind.config.ts
!/tsconfig.json
!/vercel.json
!/WHAT_IS_REAL.md

# ==============================================================================
# Dependencies, Builds, and Runtime Artifacts
# ==============================================================================
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
*.log

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# System / OS
.DS_Store
Thumbs.db

# Secrets & Local Environment
.env
.env.local
.env.*.local

# Backup and temp files
*.bak
*.tmp
*.swp

# Media generated by demo kits
public/audio/
docs/demo.mp4
docs/fallback.mp4
docs/*.gif

# IDEs & Deploy Tools
.vscode/
.idea/
.vercel
.vercel/
.kit/
.next/
.next

# User ignored files and directories
docs/
docs/**
CLAIM_LEDGER.md
claim_ledger.md